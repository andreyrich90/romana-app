# Supabase project for accounts and saved progress (Project Settings → API).
# Both values are public by design: row-level security in supabase/schema.sql protects the data.
# Without them the app runs in guest mode and hides the account button.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where confirmation and password-reset emails lead from the native app.
EXPO_PUBLIC_SITE_URL=https://romana-app-seven.vercel.app
