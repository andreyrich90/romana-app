{
  "expo": {
    "name": "Română",
    "slug": "romana-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pro.seajobs.romana",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2446A8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pro.seajobs.romana",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Română — румынский язык",
      "shortName": "Română",
      "lang": "ru",
      "themeColor": "#2446A8",
      "backgroundColor": "#EEF2FB",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2446A8",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B1230"
          }
        }
      ]
    ],
    "scheme": "romana",
    "description": "Румынский язык с нуля: короткие уроки с объяснениями на русском и украинском.",
    "primaryColor": "#2446A8"
  }
}
